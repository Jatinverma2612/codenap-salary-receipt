# Server Configuration
PORT=5000
NODE_ENV=development

# Existing MongoDB database connection string (keep actual URI only in local/server .env)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication secret (generate a strong random 64-char hex string in .env)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple; never "*")
CORS_ORIGIN=http://localhost:5173

# Cookie SameSite policy: "lax" (same domain/proxy) or "none" (cross-origin HTTPS production)
COOKIE_SAME_SITE=lax

# Serve built frontend/dist in production automatically ("auto" | "true" | "false")
SERVE_FRONTEND=auto
